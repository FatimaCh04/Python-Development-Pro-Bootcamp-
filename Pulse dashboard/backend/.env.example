# ─── Database ────────────────────────────────────────────────────────────────
# Local PostgreSQL:  postgresql://user:password@localhost:5432/pulse_db
# SQLite fallback:   sqlite:///pulse_dev.db
DATABASE_URL=sqlite:///pulse_dev.db

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Expiry in seconds (defaults: 900 = 15 min, 2592000 = 30 days)
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=2592000

# ─── AWS S3  (leave blank to disable image upload) ───────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local dev:    http://localhost:5173
# Production:   https://pulse-dashboard.vercel.app
CORS_ORIGIN=http://localhost:5173
