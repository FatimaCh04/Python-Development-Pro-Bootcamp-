# .env.example — Configuration template for VAULT backend
# Copy this to .env and fill in production values

# Allowed CORS origins (comma-separated list)
# For local dev: http://localhost:8000,http://127.0.0.1:8000
# For production: https://vault.yourdomain.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Session timeout in seconds (default: 300 = 5 minutes)
SESSION_TIMEOUT_SECONDS=300

# Path to the encrypted vault file (default: vault.json in backend/)
VAULT_PATH=vault.json

# Rate limiting configuration
# Maximum unlock/setup attempts per IP within the time window
RATE_LIMIT_MAX_ATTEMPTS=5
# Time window in seconds for rate limiting (default: 300 = 5 minutes)
RATE_LIMIT_WINDOW_SECONDS=300

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
