# =============================================================================
# Field & Form — environment template
# Copy to .env and fill in real values before running the app.
# =============================================================================

# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_APP=run.py
# development | production | testing
FLASK_ENV=development
FLASK_DEBUG=0

# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev (no Docker): leave blank to use SQLite (auto-created as fieldform.db)
# Docker / production:   set to the PostgreSQL URL below
DATABASE_URL=postgresql://fieldform:fieldform@localhost:5432/fieldform

# PostgreSQL container credentials (used by the postgres service in docker-compose.yml).
# Must match the values in DATABASE_URL above.
POSTGRES_USER=fieldform
POSTGRES_PASSWORD=fieldform
POSTGRES_DB=fieldform

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Get from: stripe listen --forward-to localhost:5000/api/checkout/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── Redis (Celery broker + result backend) ───────────────────────────────────
# Local dev without Docker: leave blank → Celery runs in eager/sync mode
# Docker / production:      use the Redis service hostname
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave SMTP_USER blank to suppress sending (emails logged to console instead).
# For Gmail, use an App Password (not your login password):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=noreply@fieldandform.com

# ── Frontend ─────────────────────────────────────────────────────────────────
# CORS and Stripe success/cancel redirect base URL.
# Frontend
# Must match the Flask server origin so Stripe redirects back correctly after payment.
# Local dev: http://127.0.0.1:5000   Production: https://yourdomain.com
FRONTEND_URL=http://127.0.0.1:5000
